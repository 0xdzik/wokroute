{"nodes": [{"id": "src_console_cli_tools_injectors_contract", "label": "CLI Tools Injector Contract", "file_type": "document", "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_console_cli_tools_injectors_contract_toolinjector", "label": "ToolInjector Interface", "file_type": "concept", "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "lines 3-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every CLI tool injector must implement the same four-method interface (getStatus, apply, reset, download) with a toolId, so the console can drive any tool uniformly. Exported as a const named xxxInjector."}, {"id": "src_console_cli_tools_injectors_contract_fs_ops_helpers", "label": "fs-ops Helper Catalog", "file_type": "concept", "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "lines 18-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Injectors share one helper library (../fs-ops) for file, TOML, env, and endpoint operations instead of reimplementing them, keeping config edits consistent and merge-safe."}, {"id": "src_console_cli_tools_injectors_contract_toolstatus", "label": "ToolStatus Shape", "file_type": "concept", "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "lines 48-61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Status reports installed/configured state plus sanitized current settings; API keys are always prefix-only, never the full secret."}, {"id": "src_console_cli_tools_injectors_contract_applyinput", "label": "ApplyInput Shape", "file_type": "concept", "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "lines 63-73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_console_cli_tools_injectors_contract_injector_rules", "label": "Nine Injector Implementation Rules", "file_type": "rationale", "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "lines 75-86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merge-don't-overwrite protects user settings; reset removes only wokroute-injected fields; download never writes to disk; type-only imports and no dynamic imports keep the bundle analyzable; provider name is 'wokroute' not '9router'."}, {"id": "src_console_cli_tools_injectors_contract_wokroute_provider_name", "label": "wokroute Provider Naming Rule", "file_type": "rationale", "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "line 83 (rule 7)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provider name in all generated tool configs must be 'wokroute', explicitly NOT '9router' \u2014 prevents brand confusion in downstream tool UIs."}], "edges": [{"source": "src_console_cli_tools_injectors_contract", "target": "src_console_cli_tools_injectors_contract_toolinjector", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "section 'Interface (must implement)'", "weight": 1.0}, {"source": "src_console_cli_tools_injectors_contract", "target": "src_console_cli_tools_injectors_contract_fs_ops_helpers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "section 'Available fs-ops helpers'", "weight": 1.0}, {"source": "src_console_cli_tools_injectors_contract", "target": "src_console_cli_tools_injectors_contract_toolstatus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "console/cli-tools/injectors/CONTRACT.md", "source_location": "sec